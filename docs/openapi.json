        }
      }
    },
    "/api/listings/{id}/buy": {
      "post": {
        "operationId": "buyListing",
        "summary": "Buy at the asking price",
        "description": "The first successful buyer locks the item for 24 hours and receives the seller's contact details. Cancel if locked by mistake.",
